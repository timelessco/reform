{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "react-hooks",
    "react-perf",
    "typescript",
    "jsx-a11y",
    "import",
    "unicorn",
    "promise",
    "node",
    "oxc",
    "jsdoc"
  ],
  "jsPlugins": [
    "@shadcn/lint",
    "@tanstack/eslint-plugin-query",
    { "name": "react-hooks-js", "specifier": "eslint-plugin-react-hooks" },
    { "name": "anti-slop", "specifier": "./tools/oxlint/anti-slop/index.ts" }
  ],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "style": "off",
    "restriction": "off"
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-console": "off",
    "no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
    "func-style": ["error", "expression", { "allowArrowFunctions": true }],
    "arrow-body-style": ["error", "as-needed"],

    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",

    "react-hooks-js/set-state-in-render": "warn",
    "react-hooks-js/set-state-in-effect": "warn",
    "react-hooks-js/no-deriving-state-in-effects": "warn",
    "react-hooks-js/purity": "warn",
    "react-hooks-js/immutability": "warn",
    "react-hooks-js/refs": "warn",
    "react-hooks-js/globals": "warn",
    "react-hooks-js/static-components": "warn",
    "react-hooks-js/error-boundaries": "warn",
    "react-hooks-js/use-memo": "warn",
    "react-hooks-js/void-use-memo": "warn",
    "react-hooks-js/preserve-manual-memoization": "warn",
    "react-hooks-js/incompatible-library": "warn",
    "react-hooks-js/unsupported-syntax": "warn",
    "react-hooks-js/gating": "warn",
    "react-hooks-js/config": "warn",

    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn",
    "typescript/prefer-ts-expect-error": "warn",
    "typescript/no-floating-promises": "warn",
    "typescript/unbound-method": "warn",

    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/no-cycle": "warn",
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],

    "unicorn/no-null": "off",
    "unicorn/filename-case": "off",
    "unicorn/no-array-for-each": "off",
    "unicorn/no-useless-undefined": "off",

    "promise/no-nesting": "warn",
    "promise/no-return-wrap": "error",
    "promise/always-return": "off",

    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/click-events-have-key-events": "warn",
    "jsx-a11y/no-static-element-interactions": "warn",
    "jsx-a11y/anchor-is-valid": "off",

    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "off",

    "@tanstack/query/exhaustive-deps": "warn",
    "@tanstack/query/no-rest-destructuring": "warn",
    "@tanstack/query/stable-query-client": "error",
    "@tanstack/query/no-void-query-fn": "warn",
    "@tanstack/query/no-unstable-deps": "warn",

    "shadcn/no-inline-styles": "error",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": ["error", { "allow": ["layout"] }],
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "pattern": "Icon$",
            "allow": ["layout", "color", "shape", "effects", "motion"]
          },
          {
            "pattern": "^Button$",
            "allow": [
              "layout",
              "spacing",
              "typography",
              "color",
              "shape",
              "effects",
              "motion",
              "elevation-pop",
              "elevation-sm"
            ]
          },
          {
            "pattern": "^SelectTrigger$",
            "allow": [
              "layout",
              "spacing",
              "typography",
              "color",
              "shape",
              "effects",
              "elevation-pop"
            ]
          },
          {
            "pattern": "^InputGroupButton$",
            "allow": ["layout", "spacing", "typography", "color", "shape", "elevation-pop"]
          },
          {
            "pattern": "^Input$",
            "allow": ["layout", "spacing", "typography", "shape"]
          },
          {
            "pattern": "^TabsTrigger$",
            "allow": ["layout", "spacing", "typography", "color"]
          },
          {
            "pattern": "^AccordionTrigger$",
            "allow": ["layout", "spacing", "typography", "color", "motion"]
          },
          {
            "pattern": "^SidebarHeader$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^ToggleSelect$",
            "allow": ["layout", "spacing", "typography", "color", "shape", "effects"]
          },
          {
            "pattern": "^Badge$",
            "allow": ["layout", "spacing", "typography", "color", "shape"]
          },
          {
            "pattern": "^Sidebar$",
            "allow": [
              "layout",
              "typography",
              "color",
              "shape",
              "motion",
              "slide-in-from-right-[40%]"
            ]
          },
          {
            "pattern": "^DialogContent$",
            "allow": [
              "layout",
              "spacing",
              "color",
              "shape",
              "effects",
              "motion",
              "data-closed:zoom-out-[0.98]",
              "data-open:zoom-in-[0.98]"
            ]
          },
          {
            "pattern": "^InputGroup$",
            "allow": ["layout", "spacing", "color", "shape"]
          },
          {
            "pattern": "^Card$",
            "allow": ["layout", "color", "shape"]
          },
          {
            "pattern": "^CopyButton$",
            "allow": ["layout", "spacing", "typography", "color", "shape", "effects"]
          },
          {
            "pattern": "^AlertDialogAction$",
            "allow": ["layout", "color", "effects"]
          },
          {
            "pattern": "^DropdownMenuItem$",
            "allow": ["layout", "spacing", "typography", "color", "shape"]
          },
          {
            "pattern": "^AccordionContent$",
            "allow": ["layout", "spacing", "typography", "color", "shape"]
          },
          {
            "pattern": "^Skeleton$",
            "allow": ["layout", "shape"]
          },
          {
            "pattern": "^DataGridColumnHeader$",
            "allow": ["layout", "typography", "color"]
          },
          {
            "pattern": "^CardContent$",
            "allow": ["layout", "spacing", "typography", "color"]
          },
          {
            "pattern": "^CollapsibleTrigger$",
            "allow": ["layout", "spacing", "typography", "color", "shape", "motion"]
          },
          {
            "pattern": "^EditorContainer$",
            "allow": ["layout", "spacing", "shape", "effects"]
          },
          {
            "pattern": "^SidebarFooter$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^Textarea$",
            "allow": ["layout", "typography", "color", "shape"]
          },
          {
            "pattern": "^AvatarFallback$",
            "allow": ["layout", "typography", "color", "shape"]
          },
          {
            "pattern": "^AccordionItem$",
            "allow": ["layout", "color", "shape"]
          },
          {
            "pattern": "^EditorStatic$",
            "allow": ["layout", "spacing", "typography"]
          },
          {
            "pattern": "^TabsList$",
            "allow": ["layout", "spacing", "color"]
          },
          {
            "pattern": "^Image$",
            "allow": ["layout", "color", "shape", "effects"]
          },
          {
            "pattern": "^DialogTitle$",
            "allow": ["layout", "typography", "color"]
          },
          {
            "pattern": "^DrawerContent$",
            "allow": ["layout", "color", "shape", "effects", "preview-zoom-drawer"]
          },
          {
            "pattern": "^DropdownMenuContent$",
            "allow": ["layout", "spacing", "shape"]
          },
          {
            "pattern": "^InputGroupInput$",
            "allow": ["layout", "spacing", "typography", "color", "effects"]
          },
          {
            "pattern": "^SidebarContent$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^InputOTPSlot$",
            "allow": ["layout", "typography", "color", "shape", "form-input"]
          },
          {
            "pattern": "^SidebarSection$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^ToolbarSearch$",
            "allow": ["layout", "motion"]
          },
          {
            "pattern": "^Checkbox$",
            "allow": ["layout", "color"]
          },
          {
            "pattern": "^Empty$",
            "allow": ["layout", "spacing", "shape"]
          },
          {
            "pattern": "^ToolbarPill$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^TabsIndicator$",
            "allow": ["layout", "color"]
          },
          {
            "pattern": "^Editor$",
            "allow": ["layout", "shape"]
          },
          {
            "pattern": "^DropdownMenuRadioItem$",
            "allow": ["layout", "typography"]
          },
          {
            "pattern": "^CardHeader$",
            "allow": ["layout", "spacing", "shape"]
          },
          {
            "pattern": "^DropdownMenuSubTrigger$",
            "allow": ["layout", "typography"]
          },
          {
            "pattern": "^PopoverContent$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^Label$",
            "allow": ["layout", "spacing", "color"]
          },
          {
            "pattern": "^SidebarGroup$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^Avatar$",
            "allow": ["layout", "shape"]
          },
          {
            "pattern": "^CardTitle$",
            "allow": ["layout", "typography"]
          },
          {
            "pattern": "^CardDescription$",
            "allow": ["layout", "typography"]
          },
          {
            "pattern": "^ViewToggle$",
            "allow": ["layout", "color"]
          },
          {
            "pattern": "^DropdownSelect$",
            "allow": ["layout", "form-input-error"]
          },
          {
            "pattern": "^SignaturePad$",
            "allow": ["layout", "color"]
          },
          {
            "pattern": "^MultiSelect$",
            "allow": ["layout", "form-input-error"]
          },
          {
            "pattern": "^ScrollArea$",
            "allow": ["layout", "shape"]
          },
          {
            "pattern": "^IconGlobe$",
            "allow": ["layout", "color"]
          },
          {
            "pattern": "^SelectValue$",
            "allow": ["layout", "typography"]
          },
          {
            "pattern": "^TableCell$",
            "allow": ["layout", "typography"]
          },
          {
            "pattern": "^DatePicker$",
            "allow": ["layout", "form-input-error"]
          },
          {
            "pattern": "^InputOTPGroup$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^SidebarMenu$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^Tabs$",
            "allow": ["layout", "spacing"]
          },
          {
            "pattern": "^SelectItem$",
            "allow": ["layout", "color"]
          },
          {
            "pattern": "^Logo$",
            "allow": ["layout", "color"]
          }
        ]
      }
    ],
    "shadcn/no-unknown-classes": [
      "error",
      {
        "allow": [
          "slate-dropLine",
          "slate-blockToolbarWrapper",
          "slate-gutterLeft",
          "ignore-click-outside/toolbar"
        ]
      }
    ],
    "shadcn/require-static-classes": "error",

    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "warn",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "warn",
    "anti-slop/no-conditional-empty-object-spread": "warn",
    "anti-slop/no-known-value-widening": "warn",
    "anti-slop/no-module-mocking": "warn",
    "anti-slop/no-object-parameters": "warn",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "warn",
    "anti-slop/no-shape-in-symbol-names": "warn",
    "anti-slop/no-unknown-parameters": "warn",
    "anti-slop/no-unknown-returns": "warn",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "warn",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "warn",
    "anti-slop/require-safety-comment-for-type-assertion": "warn"
  },
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": "as",
      "components": {
        "Button": "button",
        "Link": "a",
        "Input": "input"
      }
    },
    "react": {
      "formComponents": [],
      "linkComponents": [
        {
          "name": "Link",
          "linkAttribute": "to"
        }
      ],
      "version": "19.0"
    }
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true,
    "es2024": true
  },
  "globals": {},
  "ignorePatterns": [
    "**/routeTree.gen.ts",
    "**/styles.css",
    "**/node_modules/**",
    "**/.output/**",
    "**/dist/**",
    "**/public/**",
    "**/evilcharts/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**"
  ],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "plugins": ["vitest"],
      "env": {
        "vitest": true
      },
      "rules": {
        "vitest/no-disabled-tests": "warn",
        "vitest/no-focused-tests": "error",
        "vitest/expect-expect": "warn",
        "typescript/no-floating-promises": "off",
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": ["src/collections/query/**/*.ts"],
      "rules": {
        "@tanstack/query/exhaustive-deps": "off"
      }
    },
    {
      "files": ["**/routeTree.gen.ts"],
      "rules": {
        "unicorn/filename-case": "off",
        "unicorn/no-abusive-eslint-disable": "off"
      }
    },
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off",
        "shadcn/require-static-classes": "off"
      }
    },
    {
      "files": ["src/lib/og/**"],
      "rules": {
        "shadcn/no-inline-styles": "off"
      }
    }
  ]
}
